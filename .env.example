# Leave both blank to use the local, clearly labelled demonstration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel/Supabase integration aliases are also accepted automatically:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_ANON_KEY, and VITE_SUPABASE_ANON_KEY.
# Never set a frontend key to a service-role/secret key.

# Explicit opt-in for a hosted demo; Vercel builds otherwise require Supabase.
# VITE_CASHDESK_DEMO=true
